# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Supabase project used for authentication (anon key is public by design —
# the backend never trusts it; every request carries a verified user JWT)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend (see backend/.env.example for the full list)
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/auditsys
REDIS_URL=redis://localhost:6379/0
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
