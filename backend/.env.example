# Local development. In production these are pulled from Azure Key Vault
# instead (set AZURE_KEY_VAULT_URI and the backend fetches them via
# DefaultAzureCredential — no code changes needed).

ALLOWED_ORIGINS=http://localhost:3000

# Supabase (Postgres + pgvector)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Redis (use rediss:// for Azure Cache for Redis / TLS)
REDIS_URL=redis://localhost:6379/0

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-02-01

# Langfuse (observability — optional locally, no-op tracer if unset)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# Azure Key Vault (production secret source; leave unset for local dev)
AZURE_KEY_VAULT_URI=

# Security / guardrails
SECRET_KEY=change-me-in-production
CONFIDENCE_THRESHOLD=0.75
PRESIDIO_ENABLED=true
